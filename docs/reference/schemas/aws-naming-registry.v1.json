{
  "$comment": "BareCount AWS naming & tagging registry — implementation contract for the CDK guardrail Aspect. Governed by ADR DEC-e39ed3. Versioned by filename; amendments bump the version (v2, ...).",
  "version": "1",
  "governingAdr": "DEC-e39ed3",
  "format": "{scope}-{stage}-{region}-{dom}[-{tenant}]-{role}",
  "scopes": ["bcp", "bct"],
  "stages": ["dev", "stg", "prod"],
  "regionShort": {
    "ap-south-1": "aps1",
    "us-east-1": "use1",
    "us-west-2": "usw2",
    "eu-west-1": "euw1",
    "eu-central-1": "euc1",
    "ap-southeast-1": "apse1",
    "ap-southeast-2": "apse2",
    "ap-northeast-1": "apne1"
  },
  "domains": ["ntw", "aut", "dbs", "dbap", "sto", "cmp", "cch", "api", "msg", "evt", "dns", "cdn", "sct", "reg", "waf", "cer", "obs"],
  "tenantIdPattern": "^[a-z0-9]{1,12}$",
  "requiredTags": ["project", "track", "env", "unit", "Name"],
  "roles": {
    "_common": ["role", "exec-role", "task-role", "logs", "key", "sg", "client-sg"],
    "ntw": ["vpc", "igw", "nat", "nat-eip", "public", "egress", "private", "public-rt", "egress-rt", "private-rt", "flow-log"],
    "aut": ["pool", "client", "domain"],
    "dbs": ["pg", "master", "subnet-group", "param-group"],
    "dbap": ["project", "nat", "igw", "nat-eip", "public", "egress", "public-rt", "egress-rt"],
    "sto": ["bucket"],
    "cmp": ["cluster", "service", "task", "fn"],
    "cch": ["cluster", "subnet-group"],
    "api": ["api", "alb", "tg", "listener"],
    "msg": ["queue", "dlq", "topic"],
    "evt": ["bus", "rule"],
    "dns": ["zone", "record"],
    "cdn": ["dist"],
    "sct": ["secret"],
    "reg": ["repo"],
    "waf": ["acl"],
    "cer": ["cert"],
    "obs": ["dashboard", "alarm"]
  },
  "nameable": {
    "$comment": "resource type -> the physical-name property the Aspect checks against the convention name",
    "AWS::RDS::DBInstance": "DBInstanceIdentifier",
    "AWS::RDS::DBSubnetGroup": "DBSubnetGroupName",
    "AWS::RDS::DBParameterGroup": "DBParameterGroupName",
    "AWS::EC2::SecurityGroup": "GroupName",
    "AWS::IAM::Role": "RoleName",
    "AWS::S3::Bucket": "BucketName",
    "AWS::Lambda::Function": "FunctionName",
    "AWS::CodeBuild::Project": "Name",
    "AWS::SecretsManager::Secret": "Name",
    "AWS::KMS::Alias": "AliasName",
    "AWS::Logs::LogGroup": "LogGroupName",
    "AWS::ECS::Cluster": "ClusterName",
    "AWS::ECS::Service": "ServiceName",
    "AWS::ElasticLoadBalancingV2::LoadBalancer": "Name",
    "AWS::ElasticLoadBalancingV2::TargetGroup": "Name",
    "AWS::ECR::Repository": "RepositoryName"
  },
  "nonNameable": {
    "$comment": "types CloudFormation names itself; identified by the Name tag (= convention name) + stack membership",
    "types": [
      "AWS::KMS::Key",
      "AWS::EC2::VPC",
      "AWS::EC2::Subnet",
      "AWS::EC2::RouteTable",
      "AWS::EC2::Route",
      "AWS::EC2::SubnetRouteTableAssociation",
      "AWS::EC2::InternetGateway",
      "AWS::EC2::VPCGatewayAttachment",
      "AWS::EC2::NatGateway",
      "AWS::EC2::EIP",
      "AWS::EC2::FlowLog",
      "AWS::IAM::Policy"
    ],
    "identityMapping": {
      "AWS::KMS::Key": "identified by its companion AWS::KMS::Alias (alias/{base}-key) plus a Name tag {base}-key"
    }
  },
  "globalNamespaceExceptions": {
    "$comment": "namespaces global across ALL accounts; append the account id after the role for uniqueness",
    "AWS::S3::Bucket": "append-account",
    "AWS::Cognito::UserPoolDomain": "append-account"
  },
  "lengthLimits": {
    "AWS::RDS::DBInstance": 63,
    "AWS::EC2::SecurityGroup": 255,
    "AWS::IAM::Role": 64,
    "AWS::S3::Bucket": 63,
    "AWS::Lambda::Function": 64,
    "AWS::SecretsManager::Secret": 512,
    "AWS::KMS::Alias": 256,
    "AWS::Logs::LogGroup": 512,
    "AWS::ElasticLoadBalancingV2::LoadBalancer": 32,
    "AWS::ElasticLoadBalancingV2::TargetGroup": 32,
    "AWS::ECR::Repository": 256
  },
  "standingRules": {
    "devSecretsForceDelete": true,
    "tenantNotInLoadBalancerName": true,
    "tenantIdImmutableSlugInTagsOnly": true,
    "explicitPhysicalNamesNoCdkAutoIds": true
  }
}
